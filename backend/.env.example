# Copy to .env. Never commit .env.
# Each adapter runs "fake" (no key needed) or "real" (startup fails if its keys are missing).

JEV_MODE=fake
LLM_MODE=fake
PHOTON_MODE=fake
BROWSERBASE_MODE=fake
GITHUB_MODE=fake
AGENT_MODE=fake

# Jev (TypeSafe) — https://docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# GMI Cloud — OpenAI-compatible
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=zai-org/GLM-5.3
# Tested 2026-09-26 on chat/code-fix/tools/json + live Stagehand extract. Also pass: google/gemini-3.5-flash,
# moonshotai/kimi-k2.7-code, deepseek-ai/DeepSeek-V4-Pro. anthropic/claude-* exists but org is rate-limited (429).

# Photon (Spectrum Cloud, app.photon.codes) — var names provisional until API docs are confirmed
PHOTON_PROJECT_ID=
PHOTON_SECRET=

# Browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# GitHub — fine-grained PAT: Issues RW, Pull requests RW, Contents RW, Checks R
GITHUB_TOKEN=
GITHUB_REPO=kashby2004/jevathon
GITHUB_WEBHOOK_SECRET=

# Dashboard origin(s) allowed by CORS, comma-separated
FRONTEND_ORIGINS=http://localhost:5173
